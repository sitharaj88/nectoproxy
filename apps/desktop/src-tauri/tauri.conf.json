{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NectoProxy",
  "version": "0.1.2",
  "identifier": "in.sitharaj.nectoproxy.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NectoProxy",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Native window for the NectoProxy debugging proxy",
    "longDescription": "NectoProxy Desktop launches the NectoProxy HTTP/HTTPS debugging proxy and its web UI inside a native window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
