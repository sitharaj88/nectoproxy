{
  "name": "nectoproxy",
  "version": "0.1.2",
  "description": "A powerful HTTP/HTTPS debugging proxy with Web UI - a modern alternative to Charles Proxy",
  "type": "module",
  "bin": {
    "nectoproxy": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "node scripts/bundle.mjs && node scripts/copy-web-ui.mjs",
    "build:tsc": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js start",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.30.0",
    "express": "^4.18.3",
    "multer": "^1.4.5-lts.1",
    "node-forge": "^1.3.1",
    "open": "^10.0.4",
    "ora": "^8.0.1",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.0",
    "ws": "^8.19.0",
    "zod": "^3.25.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@nectoproxy/certs": "workspace:*",
    "@nectoproxy/mcp": "workspace:*",
    "@nectoproxy/core": "workspace:*",
    "@nectoproxy/server": "workspace:*",
    "@nectoproxy/storage": "workspace:*",
    "@nectoproxy/web": "workspace:*",
    "esbuild": "^0.27.3",
    "typescript": "^5.5.0",
    "@types/qrcode-terminal": "^0.12.2"
  },
  "keywords": [
    "proxy",
    "http",
    "https",
    "debugging",
    "mitm",
    "charles",
    "fiddler",
    "mitmproxy",
    "web-debugging",
    "network",
    "inspector",
    "traffic",
    "websocket",
    "ssl",
    "tls",
    "intercept"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sitharaj88/nectoproxy.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/sitharaj88/nectoproxy#readme",
  "bugs": {
    "url": "https://github.com/sitharaj88/nectoproxy/issues"
  },
  "author": {
    "name": "Sitharaj Seenivasan",
    "url": "https://sitharaj.in"
  }
}
