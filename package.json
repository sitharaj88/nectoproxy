{
  "name": "proxyscope",
  "version": "0.1.0",
  "private": true,
  "description": "A powerful HTTP/HTTPS debugging proxy with Web UI",
  "keywords": ["proxy", "http", "https", "debugging", "mitm", "charles"],
  "license": "MIT",
  "author": "Sitharaj",
  "repository": {
    "type": "git",
    "url": "https://github.com/user/proxyscope.git"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "release": "pnpm build && pnpm --filter proxyscope deploy ./publish-staging && cd publish-staging && npm publish --access public"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
